@page "{id:int}"
@model DetailsModel
@using JobTracker.Web
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.View.Application.CompanyName;
    var app = Model.View.Application;
}

<p><a asp-page="/Index">&larr; All applications</a></p>

<h1 class="h3 mb-1">@app.CompanyName</h1>
<p class="text-muted">@app.JobTitle &middot; applied @app.DateApplied.ToString("yyyy-MM-dd")</p>

<p class="fs-5">Status: <strong>@StatusDisplay.Label(Model.View)</strong></p>

@if (Model.View.Projection.Problems.Count > 0)
{
    <div class="alert alert-warning">
        <strong>This history has a problem:</strong>
        <ul class="mb-0">
            @foreach (var p in Model.View.Projection.Problems)
            {
                <li>@p</li>
            }
        </ul>
    </div>
}

<h2 class="h5 mt-4">History</h2>
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Date</th>
            <th>Change</th>
            <th>Note</th>
            <th>Recorded</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var e in Model.View.Events)
    {
        <tr>
            <td>@e.EffectiveAt.ToString("yyyy-MM-dd")</td>
            <td>
                @(e.PreviousStatus is { } p ? StatusDisplay.Label(p) : "start")
                &rarr; @StatusDisplay.Label(e.NewStatus)
            </td>
            <td>@e.Note</td>
            <td class="text-muted">@e.RecordedAt.ToString("yyyy-MM-dd HH:mm") UTC</td>
        </tr>
    }
    </tbody>
</table>

<h2 class="h5 mt-4">Change status</h2>

@if (Model.AllowedNext.Count == 0)
{
    <p class="text-muted">This is a final status. No further changes are possible.</p>
}
else
{
    <form method="post" style="max-width: 480px">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="NewStatus" class="form-label">New status</label>
            <select asp-for="NewStatus" class="form-select"
                    asp-items="@(Model.AllowedNext.Select(s => new SelectListItem(StatusDisplay.Label(s), s.ToString())))"></select>
        </div>
        <div class="mb-3">
            <label asp-for="EffectiveDate" class="form-label">Date it happened</label>
            <input asp-for="EffectiveDate" type="date" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Note" class="form-label">Note (optional)</label>
            <input asp-for="Note" class="form-control" maxlength="1000" />
        </div>

        <button type="submit" class="btn btn-primary">Save change</button>
    </form>
}
